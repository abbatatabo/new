<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="18dp">
    <TextView android:id="@+id/brand" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/qj_ink_faint" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:text="@string/brand_full" />
    <TextView android:id="@+id/study_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="@color/qj_ink" android:textSize="18sp" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/arabic" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/qj_ink" android:textSize="22sp"
        android:fontFamily="@font/amiri_quran" android:gravity="end" android:textDirection="rtl" android:layoutDirection="rtl"
        android:maxLines="3" android:ellipsize="end" />
    <TextView android:id="@+id/translation" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="2dp" android:textColor="@color/qj_ink_soft" android:textSize="13.5sp" android:fontFamily="serif"
        android:maxLines="4" android:ellipsize="end" android:text="@string/widget_empty" />
    <TextView android:id="@+id/ref" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/qj_ink_faint" android:textSize="11sp" android:maxLines="1" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="6dp" android:background="@color/qj_line" />
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <TextView android:id="@+id/row0_mark" android:layout_width="22dp" android:layout_height="wrap_content" android:textColor="@color/qj_accent" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/row0_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/qj_ink" android:textSize="13.5sp" />
        <TextView android:id="@+id/row0_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/qj_ink_faint" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <TextView android:id="@+id/row1_mark" android:layout_width="22dp" android:layout_height="wrap_content" android:textColor="@color/qj_accent" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/row1_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/qj_ink" android:textSize="13.5sp" />
        <TextView android:id="@+id/row1_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/qj_ink_faint" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp" android:visibility="gone">
        <TextView android:id="@+id/row2_mark" android:layout_width="22dp" android:layout_height="wrap_content" android:textColor="@color/qj_accent" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/row2_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/qj_ink" android:textSize="13.5sp" />
        <TextView android:id="@+id/row2_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/qj_ink_faint" android:textSize="12sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="8dp"
        android:max="1000" android:progress="0" android:progressDrawable="@drawable/widget_progress" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/progress_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/qj_ink_faint" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/cta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_pill" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:textColor="@color/qj_accent" android:textSize="12sp" android:textStyle="bold" android:text="Continue" />
    </LinearLayout>
</LinearLayout>
